[Unit]
Description=StockStream V3.0 AI 双数字人财经直播平台
Documentation=https://github.com/stockstream/stockstream
After=network.target network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=stockstream
Group=stockstream
WorkingDirectory=/opt/stockstream
Environment=PYTHONUNBUFFERED=1
Environment=STOCKSTREAM_JETSON_MODE=1
Environment=OMP_NUM_THREADS=4
Environment=MKL_NUM_THREADS=4
ExecStart=/opt/stockstream/.venv/bin/python -m src.main --port 8080
ExecStop=/bin/kill -TERM $MAINPID
Restart=always
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5

# 资源限制
MemoryMax=6G
CPUQuota=300%
TasksMax=512

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stockstream

# 安全增强
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/stockstream/data /opt/stockstream/logs /opt/stockstream/cache /opt/stockstream/backups
ReadOnlyPaths=/opt/stockstream/config

[Install]
WantedBy=multi-user.target
