# StockStream V4.0 Enterprise Edition — Environment Configuration Template
# ============================================================
# 安全策略：本文件仅包含默认值，实际部署使用环境变量或 secrets manager。
# 严禁将包含真实密钥的本文件提交到版本控制！
# ============================================================

# ── Authentication ──
STOCKSTREAM_AUTH_ENABLED=false
STOCKSTREAM_AUTH_TYPE=bearer
STOCKSTREAM_API_TOKEN=change-me-to-random-64-char-string
STOCKSTREAM_API_TOKEN_HASH=sha256
STOCKSTREAM_SESSION_SECRET=change-me-to-random-32-byte-hex

# ── Access Control ──
STOCKSTREAM_ADMIN_IP_WHITELIST=127.0.0.1,::1
STOCKSTREAM_MAX_REQUESTS_PER_MINUTE=600
STOCKSTREAM_MAX_WS_CONNECTIONS_PER_IP=5

# ── Platform ──
STOCKSTREAM_PLATFORM=auto
# auto | desktop | jetson | demo | server

# ── Environment ──
STOCKSTREAM_ENV=production
# dev | test | production | demo

# ── Server ──
STOCKSTREAM_HOST=0.0.0.0
STOCKSTREAM_PORT=8080
STOCKSTREAM_WORKERS=1
STOCKSTREAM_WEB_CONCURRENCY=1

# ── GPU ──
STOCKSTREAM_GPU_ENABLED=auto
STOCKSTREAM_CUDA_VISIBLE_DEVICES=0
STOCKSTREAM_ONNX_PROVIDERS=TensorrtExecutionProvider,CUDAExecutionProvider,CPUExecutionProvider
STOCKSTREAM_TENSORRT_FP16=1

# ── Database ──
STOCKSTREAM_DB_PATH=data/stockstream.db
STOCKSTREAM_DB_POOL_SIZE=5
STOCKSTREAM_DB_BACKUP_ENABLED=true
STOCKSTREAM_DB_BACKUP_INTERVAL_HOURS=6
STOCKSTREAM_DB_BACKUP_RETENTION_DAYS=30

# ── Logging ──
STOCKSTREAM_LOG_LEVEL=INFO
STOCKSTREAM_LOG_DIR=logs
STOCKSTREAM_LOG_MAX_SIZE_MB=100
STOCKSTREAM_LOG_BACKUP_COUNT=10
STOCKSTREAM_LOG_FORMAT=json

# ── Monitoring ──
STOCKSTREAM_MONITOR_ENABLED=true
STOCKSTREAM_MONITOR_INTERVAL_SECONDS=5
STOCKSTREAM_MONITOR_WEB_DASHBOARD=true

# ── Recovery ──
STOCKSTREAM_AUTO_RECOVERY=true
STOCKSTREAM_MAX_RESTART_ATTEMPTS=10
STOCKSTREAM_RESTART_DELAY_SECONDS=5
STOCKSTREAM_HEALTH_CHECK_INTERVAL=30

# ── Circuit Breaker ──
STOCKSTREAM_CB_FAILURE_THRESHOLD=5
STOCKSTREAM_CB_RECOVERY_TIMEOUT=30
STOCKSTREAM_CB_HALF_OPEN_MAX_CALLS=3

# ── Demo Mode ──
STOCKSTREAM_DEMO_MOCK_MARKET=true
STOCKSTREAM_DEMO_MOCK_CHAT=true
STOCKSTREAM_DEMO_MOCK_NEWS=true
STOCKSTREAM_DEMO_SPEEDUP=1.0

# ── Production ──
STOCKSTREAM_7X24_MODE=true
STOCKSTREAM_DAILY_RESTART_TIME=04:00
STOCKSTREAM_MAX_UPTIME_DAYS=30
STOCKSTREAM_RESOURCE_CHECK_INTERVAL=60

# ── Secrets (USE EXTERNAL SECRETS MANAGER IN PRODUCTION) ──
# These MUST be set via environment, never committed:
# STOCKSTREAM_EASTMONEY_TOKEN=
# STOCKSTREAM_WEBSOCKET_KEY=
# STOCKSTREAM_TENCENT_SECRET_ID=
# STOCKSTREAM_TENCENT_SECRET_KEY=
