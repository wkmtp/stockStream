# StockStream V3.0 — Jetson Xavier NX LTS 生产模式配置

# ================================================================
# 环境
# ================================================================
STOCKSTREAM_HOST=0.0.0.0
STOCKSTREAM_PORT=8080
STOCKSTREAM_ENV=production
STOCKSTREAM_LOG_LEVEL=info
STOCKSTREAM_JETSON_MODE=1

# ================================================================
# 内存控制 (Jetson Xavier NX 8GB)
# ================================================================
# 总内存限制 6GB, 为系统和 GPU 预留 2GB
STOCKSTREAM_MAX_MEMORY_MB=6144
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
NUMEXPR_MAX_THREADS=4

# ================================================================
# GPU / 推理 (JetPack 5.1.x / CUDA 11.4 / TensorRT 8.5)
# ================================================================
STOCKSTREAM_TENSORRT_ENABLED=false
ORT_TENSORRT_FP16_ENABLE=1
ORT_TENSORRT_ENGINE_CACHE_ENABLE=1
ORT_TENSORRT_ENGINE_CACHE_PATH=/opt/stockstream/cache/trt_engines
NVIDIA_VISIBLE_DEVICES=all

# ================================================================
# 数据库
# ================================================================
STOCKSTREAM_DATABASE__URL=sqlite+aiosqlite:///data/stockstream.db

# ================================================================
# 行情数据
# ================================================================
STOCKSTREAM_MARKET__POLL_SECONDS=5
STOCKSTREAM_MARKET__SYMBOLS=sh000001,sz399001,sz399006
STOCKSTREAM_MARKET__SQLITE_PATH=data/market_cache.db

# ================================================================
# AI — DeepSeek API
# ================================================================
STOCKSTREAM_DEEPSEEK_API_KEY=YOUR_KEY_HERE
STOCKSTREAM_DEEPSEEK_MODEL=deepseek-chat
STOCKSTREAM_DEEPSEEK_TIMEOUT=30.0

# ================================================================
# TTS — Piper 中文语音合成
# ================================================================
STOCKSTREAM_TTS__VOICE=zh_CN-huayan-medium
STOCKSTREAM_TTS__MODEL_PATH=models/zh_CN-huayan-medium.onnx
STOCKSTREAM_TTS__VOICE_MALE=zh_CN-chaowen-medium
STOCKSTREAM_TTS__MODEL_PATH_MALE=models/zh_CN-chaowen-medium.onnx
STOCKSTREAM_TTS__VOICE_FEMALE=zh_CN-huayan-medium
STOCKSTREAM_TTS__MODEL_PATH_FEMALE=models/zh_CN-huayan-medium.onnx
STOCKSTREAM_TTS__SAMPLE_RATE=22050
STOCKSTREAM_TTS__LENGTH_SCALE=1.0
STOCKSTREAM_TTS__NOISE_SCALE=0.667
STOCKSTREAM_TTS__NOISE_W=0.8
STOCKSTREAM_TTS__SENTENCE_SILENCE=0.2

# ================================================================
# 头像 — Wav2Lip 唇形同步
# ================================================================
STOCKSTREAM_AVATAR__ENABLED=true
STOCKSTREAM_AVATAR__HOST_IMAGE=data/host.png
STOCKSTREAM_AVATAR__FACE_DETECTOR_ONNX=models/face_detector.onnx
STOCKSTREAM_AVATAR__WAV2LIP_ONNX=models/wav2lip_gan.onnx
STOCKSTREAM_AVATAR__FPS=25
STOCKSTREAM_AVATAR__FACE_BATCH_SIZE=128
STOCKSTREAM_AVATAR__OUTPUT_DIR=data/avatar
STOCKSTREAM_AVATAR__AUTO_GENERATE=true

# ================================================================
# 视频流
# ================================================================
STOCKSTREAM_STREAM__QUEUE_SIZE=1024
STOCKSTREAM_STREAM__RTMP_URL=

# ================================================================
# 交易
# ================================================================
STOCKSTREAM_TRADER__CAPITAL=3000.0
STOCKSTREAM_TRADER__PORTFOLIO_PATH=data/portfolio.json
STOCKSTREAM_TRADER__TICK_SECONDS=10.0
STOCKSTREAM_TRADER__AUTO_OPEN=true
STOCKSTREAM_TRADER__AUTO_ADD=true
STOCKSTREAM_TRADER__AUTO_REDUCE=false
STOCKSTREAM_TRADER__AUTO_CLEAR=true
STOCKSTREAM_TRADER__REPORT_DIR=data

# ================================================================
# 日志轮转 (logrotate 配合)
# ================================================================
# /opt/stockstream/logs/*.log {
#     daily
#     rotate 30
#     maxsize 100M
#     compress
#     delaycompress
#     missingok
#     notifempty
#     copytruncate
# }
