# StockStream v2.0 环境变量配置模板
# 复制为 .env 并根据需要修改

# 基础
STOCKSTREAM_HOST=0.0.0.0
STOCKSTREAM_PORT=8000
STOCKSTREAM_LOG_LEVEL=info

# 数据库（SQLite 默认）
STOCKSTREAM_DATABASE__URL=sqlite+aiosqlite:///data/stockstream.db

# 行情采集
STOCKSTREAM_MARKET__POLL_SECONDS=5
STOCKSTREAM_MARKET__SYMBOLS=["600519","000001","300750"]

# AI 分析
STOCKSTREAM_ANALYSIS__DEEPSEEK_API_KEY=your_api_key_here
STOCKSTREAM_ANALYSIS__DEEPSEEK_MODEL=deepseek-chat

# TTS
STOCKSTREAM_TTS__VOICE=zh_CN-huayan-medium

# 推流
STOCKSTREAM_STREAM__RTMP_URL=rtmp://your-rtmp-server/live/stream

# 直播平台
STOCKSTREAM_LIVE__DOUYIN__COOKIE=
STOCKSTREAM_LIVE__DOUYIN__ROOM_ID=
STOCKSTREAM_LIVE__KUAISHOU__COOKIE=
STOCKSTREAM_LIVE__KUAISHOU__ROOM_ID=
